{
  "manifest_version": 2,
  "name": "Dawrak Browser Assistant",
  "description": "User-approved local actions and optional authenticated AI gateway; no background access.",
  "version": "0.2.0",
  "permissions": [
    "activeTab"
  ],
  "incognito": "not_allowed",
  "browser_action": {
    "default_title": "مساعد المتصفح",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dawrak-assistant@local.example",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "optional_permissions": [
    "https://*/*"
  ]
}
